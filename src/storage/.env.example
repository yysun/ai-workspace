# file | mssql
AIW_STORAGE=file

# File provider
# Uses WORKSPACE_ROOT/users/<userId> for file-backed storage.
# Falls back to ./aiw-workspace/users/<userId> if WORKSPACE_ROOT is unset.

# MSSQL provider
# AIW_STORAGE=mssql
# AIW_MSSQL_CONNECTION_STRING=Server=tcp:localhost,1433;Database=aiw;User Id=sa;Password=Your_password123;Encrypt=true;TrustServerCertificate=true;
