# Local development can copy this file to .env.
# Docker can use the same file with: docker run --env-file .env ...

PORT=3000
WORKSPACE_ROOT=/workspace

# CRM / backend API base URL (used by the api_request tool and to resolve the user identity path below).
API_BASE_URL=
AUTH_USER_PATH=

# CLI testing: access token sent as Authorization: Bearer <token> when running the streaming test CLI.
API_CLI_PAT=

# ======
# STORAGE CONFIG
# file | mssql
AIW_STORAGE=file

# AIW_STORAGE=mssql
# AIW_MSSQL_CONNECTION_STRING=Server=tcp:localhost,1433;Database=aiw;User Id=sa;Password=Your_password123;Encrypt=true;TrustServerCertificate=true;
# ======

# LLM configuration. 
LLM_MODEL=gpt-5.4-nano
LLM_MAXTOKEN=8192
LLM_MAX_CONSECUTIVE_TOOL_TURNS=25
LLM_MAX_WALL_TIME_MS=
LLM_TEMPERATURE=1
LLM_PERMISSION=auto
LLM_REASONING=medium

OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_RESOURCE_NAME=your-resource-name
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
