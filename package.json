{
  "name": "ai-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless HTTP/SSE server for one LLM chat completion turn against a mounted workspace.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "chat:cli": "node --import tsx src/cli/testChatCli.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run test:unit && npm run test:targeted && npm run test:e2e",
    "test:unit": "node --import tsx --test tests/unit/**/*.test.ts",
    "test:targeted": "node --import tsx --test tests/targeted/**/*.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "llm-runtime": "^0.5.0",
    "mssql": "^12.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.15.21",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
