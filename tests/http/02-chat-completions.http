@baseUrl = http://localhost:3000
@contentType = application/json

### Non-stream chat completion
# Expected: 200 with an assistant message when a provider is configured.
# Expected: clear 5xx runtime error when no provider credentials are configured.
POST {{baseUrl}}/chat/completions
Content-Type: {{contentType}}

{
  "model": "default",
  "stream": false,
  "messages": [
    {
      "role": "user",
      "content": "Summarize the loaded workspace context."
    }
  ]
}
